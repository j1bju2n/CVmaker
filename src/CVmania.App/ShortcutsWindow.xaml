<Window x:Class="CVmania.App.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Shortcuts.Title}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1c1f26" Foreground="#eeeeee" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource Shortcuts.Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ItemsControl Grid.Row="1" x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#2f333c" BorderThickness="0,0,0,1" Padding="0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#2c3038" BorderBrush="#3c414b" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="13" Foreground="#9fffb0"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Action}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="#dde2e8"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Row="2" x:Name="CloseButton" Content="{DynamicResource Dialog.OK}" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="18,7" MinWidth="110" Background="#2f6b3f" Foreground="#eeeeee" BorderBrush="#3c9a55"/>
    </Grid>
</Window>
