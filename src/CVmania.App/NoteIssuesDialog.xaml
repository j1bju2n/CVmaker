<Window x:Class="CVmania.App.NoteIssuesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Issues.Title}" Icon="app.ico"
        Width="680" SizeToContent="Height" MaxHeight="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1c1f26" Foreground="#eeeeee" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="#2c3038"/>
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="BorderBrush" Value="#3c414b"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#9fffb0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2,4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="HeadingText" Text="{DynamicResource Issues.Heading}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="SummaryText" Foreground="#dde2e8" Margin="0,8,0,6" TextWrapping="Wrap"/>
        <ToggleButton Grid.Row="2" x:Name="DetailsToggle" Checked="DetailsToggle_Changed" Unchecked="DetailsToggle_Changed"/>
        <ScrollViewer Grid.Row="3" x:Name="DetailsScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,6,0,0"
                      Background="#111318" BorderBrush="#3c414b" Padding="8">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#2f333c" BorderThickness="0,0,0,1" Padding="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding OutTime}" FontFamily="Consolas" Foreground="#9fffb0"/>
                                <TextBlock Grid.Column="1" Text="{Binding OrigTime}" FontFamily="Consolas" Foreground="#9aa"/>
                                <TextBlock Grid.Column="2" Text="{Binding ColumnText}" Foreground="#dde2e8"/>
                                <TextBlock Grid.Column="3" Text="{Binding Description}" Foreground="#dde2e8" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource Issues.Cancel}" Click="CancelButton_Click"/>
            <Button x:Name="ContinueButton" Content="{DynamicResource Issues.Continue}" Click="ContinueButton_Click" Background="#6b3f2f" BorderBrush="#9a553c" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
