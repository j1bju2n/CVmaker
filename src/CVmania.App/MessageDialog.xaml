<Window x:Class="CVmania.App.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1c1f26" Foreground="#eeeeee" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="#2c3038"/>
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="BorderBrush" Value="#3c414b"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image x:Name="IconImage" Grid.Row="0" Grid.Column="0" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top" Visibility="Collapsed"/>
        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="21" Foreground="#dde2e8"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="NoButton" Click="NoButton_Click" Visibility="Collapsed"/>
            <Button x:Name="YesButton" Click="YesButton_Click" Background="#2f6b3f" BorderBrush="#3c9a55" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
