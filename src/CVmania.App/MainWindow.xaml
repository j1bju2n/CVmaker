<Window x:Class="CVmania.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CVmania.App.Controls"
        Title="{DynamicResource App.Title}" Icon="app.ico"
        Width="1320" Height="860" MinWidth="960" MinHeight="620"
        Background="#15171c" Foreground="#dddddd"
        FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#2c3038"/>
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="BorderBrush" Value="#3c414b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3a404a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SnapButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#2c3038" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="3,1,1,1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="BorderBrush" Value="#3c414b"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#aaaaaa"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#242a33"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2f6b3f"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#20232a"/>
            <Setter Property="Foreground" Value="#aaaaaa"/>
            <Setter Property="BorderBrush" Value="#3c414b"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*" MinHeight="110"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================ menu ============================ -->
        <Menu Grid.Row="0" IsMainMenu="False" Background="#20232a" BorderBrush="#2f333c" BorderThickness="0,0,0,1">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#111111"/>
                </Style>
            </Menu.Resources>
            <Menu.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#dddddd"/>
                    <Setter Property="Padding" Value="10,4"/>
                </Style>
            </Menu.ItemContainerStyle>
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Header="{DynamicResource Menu.Open}" Click="OpenOsuButton_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="{DynamicResource Menu.Reload}" Click="ReloadButton_Click" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu.Export}" Click="ExportButton_Click" InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu.Exit}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.View}">
                <MenuItem Header="{DynamicResource Menu.ZoomFit}" Click="ZoomFit_Click" InputGestureText="Z"/>
                <MenuItem x:Name="FollowPlayheadMenu" Header="{DynamicResource Menu.FollowPlayhead}" IsCheckable="True" IsChecked="True" Click="FollowPlayheadMenu_Click"/>
                <MenuItem x:Name="FollowOsuMenu" Header="{DynamicResource Menu.FollowOsu}" IsCheckable="True" IsChecked="True" Click="FollowOsuMenu_Click"/>
                <Separator/>
                <MenuItem x:Name="ShowNotesMenu" Header="{DynamicResource Menu.ShowNotes}" IsCheckable="True" IsChecked="True" Click="ShowNotesMenu_Click"/>
                <MenuItem x:Name="ShowBookmarksMenu" Header="{DynamicResource Menu.ShowBookmarks}" IsCheckable="True" IsChecked="True" Click="ShowBookmarksMenu_Click"/>
            </MenuItem>
            <MenuItem x:Name="LanguageMenu" Header="{DynamicResource Menu.Language}"/>
            <MenuItem Header="{DynamicResource Menu.Help}">
                <MenuItem Header="{DynamicResource Menu.Shortcuts}" Click="Shortcuts_Click"/>
                <MenuItem Header="{DynamicResource Menu.About}" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ============================ osu! connection & map ============================ -->
        <Border Grid.Row="1" Background="#20232a" Padding="10,6" BorderBrush="#2f333c" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,16,0">
                    <Ellipse x:Name="OsuDot" Width="10" Height="10" Fill="#777" Margin="0,0,6,0"/>
                    <TextBlock x:Name="OsuStatusText" Text="{DynamicResource Status.NotRunning}" FontWeight="SemiBold" MinWidth="220"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock x:Name="MapTitleText" Text="{DynamicResource Map.None}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MapInfoText" Text="" Foreground="#9aa" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox x:Name="FollowOsuCheck" Content="{DynamicResource Map.Follow}" IsChecked="True" Checked="FollowOsuCheck_Changed" Unchecked="FollowOsuCheck_Changed"/>
                    <Button x:Name="OpenOsuButton" Content="{DynamicResource Map.Open}" Click="OpenOsuButton_Click"/>
                    <Button x:Name="ReloadButton" Content="{DynamicResource Map.Reload}" Click="ReloadButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ BPM sections strip ============================ -->
        <Border Grid.Row="2" Background="#1a1d24" Padding="10,4" BorderBrush="#2f333c" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Bpm.Label}" Foreground="#aaa" Margin="0,0,8,0" MinWidth="90"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BpmSectionsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Tag="{Binding StartMs}" Click="BpmChip_Click" Padding="8,2" Margin="2,0" Background="#3a2a2a" BorderBrush="#7a3a3a" ToolTip="{Binding Tooltip}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================ snap strip ============================ -->
        <Border Grid.Row="3" Background="#1a1d24" Padding="10,4" BorderBrush="#2f333c" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Snap.Label}" Foreground="#aaa" Margin="0,0,8,0" MinWidth="90" ToolTip="{DynamicResource Snap.Tip}"/>
                <StackPanel x:Name="SnapPanel" Orientation="Horizontal"/>
            </DockPanel>
        </Border>

        <!-- ============================ waveforms ============================ -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <controls:WaveformView x:Name="Overview"/>
                <Canvas IsHitTestVisible="False">
                    <Line x:Name="OverviewPlayhead" Y1="0" Y2="64" Stroke="#ff9f1c" StrokeThickness="1.5" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
            <Grid Grid.Row="2">
                <controls:WaveformView x:Name="Detail"/>
                <Canvas IsHitTestVisible="False">
                    <Line x:Name="DetailPlayhead" Y1="0" Y2="1000" Stroke="#ff9f1c" StrokeThickness="2" Visibility="Collapsed"/>
                </Canvas>
                <TextBlock x:Name="LoadingText" Text="Loading..." FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#ccc" Visibility="Collapsed"/>
                <Popup x:Name="FadePopup" StaysOpen="False" AllowsTransparency="True" Placement="Relative" PlacementTarget="{Binding ElementName=Detail}">
                    <Border Background="#20232a" BorderBrush="#9fffb0" BorderThickness="1" CornerRadius="4" Padding="10" Width="280">
                        <StackPanel>
                            <TextBlock x:Name="FadeTitle" FontWeight="SemiBold" Foreground="#eee"/>
                            <CheckBox x:Name="FadeExtendCheck" Content="{DynamicResource Fade.Extend}" Margin="0,6,0,2" Checked="FadeExtend_Changed" Unchecked="FadeExtend_Changed"/>
                            <TextBlock x:Name="FadeHint" Foreground="#9aa" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <DockPanel>
                                <TextBox x:Name="FadeBox" DockPanel.Dock="Right" Width="64" KeyDown="FadeBox_KeyDown" LostFocus="FadeBox_LostFocus"/>
                                <Slider x:Name="FadeSlider" Minimum="0" Maximum="1000" SmallChange="10" LargeChange="100" ValueChanged="FadeSlider_ValueChanged" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="FadeMaxText" Foreground="#9aa" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch" Background="#2f333c" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

        <!-- ============================ transport ============================ -->
        <Border Grid.Row="6" Background="#20232a" Padding="10,6" BorderBrush="#2f333c" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button x:Name="PlayButton" Content="{DynamicResource Transport.Play}" Click="PlayButton_Click" Width="110" IsEnabled="False"/>
                <Button x:Name="StopButton" Content="{DynamicResource Transport.Stop}" Click="StopButton_Click" IsEnabled="False"/>
                <TextBlock x:Name="PositionText" Text="00:00.000 / 00:00.000" FontFamily="Consolas" FontSize="14" Margin="10,0" MinWidth="200"/>
                <TextBlock x:Name="PreviewModeText" Text="" Foreground="#ffd700" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Transport.SelStart}" Click="SetSelStart_Click"/>
                <Button Content="{DynamicResource Transport.SelEnd}" Click="SetSelEnd_Click"/>
                <CheckBox x:Name="LoopSelectionCheck" Content="{DynamicResource Transport.Loop}" Checked="LoopSelectionCheck_Changed" Unchecked="LoopSelectionCheck_Changed"/>
                <CheckBox x:Name="FollowPlayheadCheck" Content="{DynamicResource Transport.Follow}" IsChecked="True" Checked="FollowPlayheadCheck_Changed" Unchecked="FollowPlayheadCheck_Changed"/>
                <Button Content="{DynamicResource Transport.ZoomFit}" Click="ZoomFit_Click"/>
                <Label Content="{DynamicResource Transport.Volume}"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8" Width="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                <TextBlock x:Name="SelectionText" Text="" Foreground="#9aa" Margin="10,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- ============================ regions ============================ -->
        <Border Grid.Row="7" Background="#1a1d24" Padding="10,6" BorderBrush="#2f333c" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListView x:Name="RegionsList" Grid.Column="0" Background="#111318" Foreground="#ddd" BorderBrush="#3c414b" SelectionMode="Single" SelectionChanged="RegionsList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Index}"/>
                            <GridViewColumn Header="{DynamicResource Regions.Col.Start}" Width="95" DisplayMemberBinding="{Binding StartText}"/>
                            <GridViewColumn Header="{DynamicResource Regions.Col.End}" Width="95" DisplayMemberBinding="{Binding EndText}"/>
                            <GridViewColumn Header="{DynamicResource Regions.Col.Length}" Width="95" DisplayMemberBinding="{Binding LengthText}"/>
                            <GridViewColumn Header="{DynamicResource Regions.Col.Out}" Width="95" DisplayMemberBinding="{Binding OutStartText}"/>
                            <GridViewColumn Header="{DynamicResource Regions.Col.FadeIn}" Width="80" DisplayMemberBinding="{Binding FadeInText}"/>
                            <GridViewColumn Header="{DynamicResource Regions.Col.FadeOut}" Width="80" DisplayMemberBinding="{Binding FadeOutText}"/>
                            <GridViewColumn Header="{DynamicResource Regions.Col.Grid}" Width="260" DisplayMemberBinding="{Binding GridText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="250">
                    <DockPanel Margin="2,0,0,4">
                        <TextBlock x:Name="RegionsSummaryText" DockPanel.Dock="Right" Text="{DynamicResource Regions.None}" Foreground="#9aa" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                        <TextBlock Text="{DynamicResource Regions.Title}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Button x:Name="AddRegionButton" Content="{DynamicResource Regions.Add}" Click="AddRegionButton_Click" IsEnabled="False" Padding="10,3"/>
                    <Button x:Name="RemoveRegionButton" Content="{DynamicResource Regions.Delete}" Click="RemoveRegionButton_Click" IsEnabled="False" Padding="10,3"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FadeInButton" Content="{DynamicResource Regions.FadeIn}" Click="FadeInButton_Click" IsEnabled="False" Width="121" Padding="10,3"/>
                        <Button x:Name="FadeOutButton" Content="{DynamicResource Regions.FadeOut}" Click="FadeOutButton_Click" IsEnabled="False" Width="121" Padding="10,3"/>
                    </StackPanel>
                    <Button x:Name="ClearRegionsButton" Content="{DynamicResource Regions.Clear}" Click="ClearRegionsButton_Click" IsEnabled="False" Padding="10,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ bottom bar ============================ -->
        <Border Grid.Row="8" Background="#20232a" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ExportButton" Content="{DynamicResource Bottom.Export}" Click="ExportButton_Click" Background="#2f6b3f" BorderBrush="#3c9a55" FontWeight="SemiBold" MinWidth="150" IsEnabled="False"/>
                <Button DockPanel.Dock="Right" x:Name="PreviewCutButton" Content="{DynamicResource Bottom.Preview}" Click="PreviewCutButton_Click" MinWidth="130" IsEnabled="False"/>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Msg.AddRegionHint}" Foreground="#9aa" TextWrapping="Wrap" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
